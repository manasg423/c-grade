{
  "problem": "string_length",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.5,
      "params": {
        "testset_dir": "tests/str_len/",
        "oracle_path": "tests/str_len/oracle.c",
        "auto_generate": true,
        "num_generated_tests": 5,
        "seed": 42
      }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.5,
      "params": {
        "oracle_path": "tests/str_len/oracle.c",
        "cases": ["empty", "whitespace"],
        "test_inputs": [
          "hello",
          "a",
          "supercalifragilisticexpialidocious",
          "special_!@#$_chars"
        ],
        "seed": 42
      }
    }
  ]
}
